# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Runtime data
runs/

# Environment
.env
.env.*

# User-specific environment config (API keys, credentials)
configs/environments/

# IDE specific files
steveX.code-workspace

# Vendored mod build/runtime artifacts (source is tracked; these are regenerable)
vendor/**/build/
vendor/**/.gradle/
vendor/**/run/

# Decompiled Minecraft sources (local reference only — no build reads this; 6.6k files / 39 MB)
1.21.11_src/

# Agent runtime artifacts: task event logs and slow-tree versions grow without bound
/runtime/


# Python tooling artifacts
__pycache__/
*.pyc

# DSH is an exact npm dependency. Keep upstream source checkouts outside this
# repository; steveX-owned plugins remain under dsh-plugins/.

# Training products: the capsule library, the task history, the fast-tree version chain and the fact library are written
# by the agent during in-game runs and stay local (the directories are created on first save)
/src/capsules/
/src/history/
/src/bt/trees/fast/
/facts/
